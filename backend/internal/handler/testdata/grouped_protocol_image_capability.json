{
  "version": 1,
  "image": {
    "references": {
      "promptMaxChars": 32000,
      "maxImages": 16,
      "maxImageBytes": 31457280,
      "maskSupported": true
    },
    "size": {
      "parameter": "size",
      "values": ["1:1"],
      "default": "1:1",
      "allowCustom": true,
      "presets": [{"tier": "1k", "ratio": "1:1", "size": "1024x1024", "width": 1024, "height": 1024}]
    },
    "resolution": {"supported": true, "values": ["1k"], "default": "1k"},
    "quality": {"supported": false, "values": ["auto", "low", "medium", "high"], "default": "auto"},
    "transparentBackground": {"supported": false, "default": false},
    "responseFormat": {"supported": true, "default": "auto"},
    "outputFormat": {"supported": true},
    "maxOutputs": 1
  }
}
