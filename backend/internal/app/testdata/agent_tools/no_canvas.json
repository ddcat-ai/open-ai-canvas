            "type": "string"
          },
          "skillIds": {
            "items": {
              "description": "skill_market_search 返回的 skillId",
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "skillIds",
          "reason"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "查询当前画布内属于当前用户的生成任务状态",
      "name": "task_get",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "description": "真实任务ID",
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ],
