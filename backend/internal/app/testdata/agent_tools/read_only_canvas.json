  {
    "function": {
      "description": "维护与当前用户要求一致的多步任务清单。items 整表替换，完成项按真实结果更新 status；已取消或不再相关的项从清单移除，全部取消可传空数组，不得把取消项标成 done。清单会显示在界面并作为后续上下文，不构成额外授权。简单问答或单点修改不要求先建清单。",
      "name": "plan_update",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "description": "短标识，如 1",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pending",
                    "doing",
                    "done"
                  ],
                  "type": "string"
                },
                "title": {
                  "description": "这一项要做什么",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "status"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "创作目标仍有未解决且会实质改变结果的选择时才调用。本轮只问一次：单项用 options，多项相关偏好用 fields 合并为可编辑紧凑表单（最多16项，可用 section 分组，一次问完），并给出推荐值；长流程开工前的问卷设 recordDecision=true，用户提交后画布会生成「决策确认单」；模型等低频项可选并默认自动推荐。用户已明确方向、授权自主决定或说“按推荐/直接开始”时不问；不要把无依据的猜测当作安全默认。本轮就此收尾，用户提交后自动续轮；服务端最多允许 2 轮确认。",
      "name": "ask_user",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "allowFreeform": {
            "description": "是否允许在表单外补充说明（默认允许）",
            "type": "boolean"
          },
          "fields": {
            "description": "多个相关创作参数组成的动态表单；与 options 二选一",
            "items": {
              "additionalProperties": false,
              "properties": {
                "allowCustom": {
                  "type": "boolean"
                },
                "defaultValue": {
                  "anyOf": [
                    {
                      "description": "推荐默认值；可选",
                      "type": "string"
                    },
                    {
                      "items": {
                        "description": "默认选项",
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "id": {
                  "description": "稳定字段 ID，如 aspectRatio",
                  "type": "string"
                },
                "options": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "detail": {
                        "description": "可选说明",
                        "type": "string"
                      },
                      "id": {
                        "description": "稳定选项 ID",
                        "type": "string"
                      },
                      "label": {
                        "description": "选项名称",
                        "type": "string"
                      },
                      "recommended": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "type": "object"
                  },
                  "maxItems": 8,
                  "type": "array"
                },
                "placeholder": {
                  "description": "输入提示",
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "section": {
                  "description": "可选：分组名，如 画面、节奏、交付",
                  "type": "string"
                },
                "title": {
                  "description": "字段显示名称",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "single_select",
                    "multi_select",
                    "segmented",
                    "text",
                    "textarea",
                    "model_picker"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "type"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "maxRounds": {
            "description": "可选确认上限；服务端以固定上限为准",
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "options": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "description": "可选：一句补充说明",
                  "type": "string"
                },
                "label": {
                  "description": "选项文字",
                  "type": "string"
                }
              },
              "required": [
                "label"
              ],
              "type": "object"
            },
            "maxItems": 6,
            "minItems": 2,
            "type": "array"
          },
          "question": {
            "description": "要用户确认的主题，一句话说清",
            "type": "string"
          },
          "questionId": {
            "description": "可选的稳定问题标识",
            "type": "string"
          },
          "recordDecision": {
            "description": "true=用户提交后在画布生成「决策确认单」Markdown 节点，后续步骤以它为准",
            "type": "boolean"
          },
          "round": {
            "description": "可选确认轮次；服务端以持久化轮次为准",
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
