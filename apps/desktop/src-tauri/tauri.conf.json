{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "影策",
  "identifier": "ai.ddcat.open-ai-canvas",
  "build": {
    "beforeBuildCommand": "bash scripts/stage-assets.sh",
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "影策",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "externalBin": ["binaries/canvas-server"],
    "resources": {
      "resources/web": "web",
      "resources/pi-runtime.tar.gz": "pi-runtime.tar.gz",
      "resources/plugin-packages": "plugin-packages"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  }
}
