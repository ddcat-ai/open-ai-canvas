[Unit]
Description=Open AI Canvas Go frontend server
After=network-online.target open-ai-canvas-backend.service
Wants=network-online.target

[Service]
Type=simple
User=openaicanvas
Group=openaicanvas
WorkingDirectory=/var/lib/open-ai-canvas
ExecStart=/opt/open-ai-canvas/current/open-ai-canvas-web -addr 127.0.0.1:3000 -root /opt/open-ai-canvas/current/dist
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
