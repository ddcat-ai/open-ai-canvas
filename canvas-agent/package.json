{
  "name": "kraftreel-cli",
  "version": "0.1.0",
  "description": "KraftReel remote canvas MCP CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kraftreel": "./dist/index.js",
    "canvas-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "python",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "clean": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "KraftReel",
  "repository": {
    "type": "git",
    "url": "https://github.com/wurendao007/open-ai-canvas.git",
    "directory": "canvas-agent"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
