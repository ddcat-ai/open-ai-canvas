# 本文件只声明可公开的运行配置，不要在这里填写任何密钥。
CANVAS_REGISTRATION_ENABLED=false
# 可选 OIDC 登录，留空关闭。Client Secret 仅写入部署环境。
CANVAS_OIDC_ISSUER=
CANVAS_OIDC_CLIENT_ID=
CANVAS_OIDC_CLIENT_SECRET=
# 在提供方登记完整的 HTTPS 回调地址，路径为 /api/auth/oidc/callback。
CANVAS_OIDC_REDIRECT_URL=
# 可选：ID Token 的 groups 中必须包含此值。开启后，组内用户可在公开注册关闭时首次开户。
CANVAS_OIDC_ALLOWED_GROUP=
# 默认拒绝后端访问本机和私网；可信私网或 HTTP 服务按主机精确放行，不要填写协议、端口或路径。
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
# 多个主机使用英文逗号分隔，例如：gateway.internal,192.168.1.10
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
# MCP 使用独立的精确主机白名单，不继承模型渠道的私网放行项，也不使用 HTTP_PROXY/HTTPS_PROXY。
CANVAS_MCP_ALLOWED_PRIVATE_HOSTS=
CANVAS_CORS_ORIGINS=http://localhost:3000
# 服务器对模型上游可访问的地址：本地存储的短时签名链接（Agent 看图、生成任务参考图）由它拼出，
# 内网部署还要把该主机放进 CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS。留空则本地存储无法签出链接。
CANVAS_PUBLIC_BASE_URL=
# 启用服务商插件系统以支持特定服务的模型发现（如阿里云百炼的视频生成模型）
# 设置为 true 启用插件机制，false 使用传统方式（默认：false）
ENABLE_PROVIDER_PLUGINS=false
CANVAS_DATA_PATH=./data
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
# 可选：图片/音频等非视频异步任务轮询遇到连接中断、5xx、429 时连续重试的次数（0-10），默认 0 即首次出错就结束任务。
# CANVAS_ASYNC_POLL_TRANSIENT_RETRIES=0
# 时间线字幕转写由本地 whisper.cpp 服务执行；指向其 HTTP 地址（如 http://127.0.0.1:8082），不配置则转写任务明确失败。
CANVAS_WHISPER_BASE_URL=
# 时间线渲染/播放副本转码使用的 ffmpeg 可执行文件；留空时在 PATH 中查找。
CANVAS_FFMPEG_PATH=
# 收到 SIGTERM 后等待活动后台任务完成的最长时间；生产 Compose 的 stop_grace_period 使用同一值。
CANVAS_SHUTDOWN_TIMEOUT=10m
# 开发和旧部署默认由后端启动时迁移；受管生产部署由独立 migrate 服务执行并将此项设为 false。
CANVAS_AUTO_MIGRATE=true
# 生产在线更新由宿主机 Host Updater 提供；安装脚本生成随机 Token，不要手工提交真实值。
CANVAS_UPDATER_TOKEN=
# 生产 Agent 运行在独立的 yingce-agent 容器。安装脚本生成随机 Token，不要手工提交真实值。
# YINGCE_AGENT_TOKEN=
# CANVAS_YINGCE_AGENT_IMAGE=ghcr.io/<owner>/open-ai-canvas-yingce-agent:<tag>@sha256:...
# 以下资源边界由 docker-compose.deploy.yml 使用；修改后重建对应容器。
YINGCE_AGENT_MAX_SESSIONS=8
# 独立部署硬上限，管理员运行策略无法超过；调高前同时评估内存与临时目录预算。
YINGCE_AGENT_SESSION_CAP=8
YINGCE_AGENT_NODE_MEMORY_MB=512
YINGCE_AGENT_MAX_QUEUE=64
YINGCE_AGENT_QUEUE_TIMEOUT_SECONDS=60
YINGCE_AGENT_BODY_TIMEOUT_SECONDS=30
YINGCE_AGENT_KILL_GRACE_SECONDS=5
YINGCE_AGENT_ORPHAN_TTL_SECONDS=86400
YINGCE_AGENT_TMPFS_SIZE=512m
YINGCE_AGENT_MEMORY_LIMIT=4g
YINGCE_AGENT_CPUS=2
YINGCE_AGENT_PIDS_LIMIT=256
CANVAS_BACKEND_MEMORY_LIMIT=4g
CANVAS_BACKEND_CPUS=2
CANVAS_BACKEND_PIDS_LIMIT=256
CANVAS_LOG_MAX_SIZE=10m
# 宿主机嵌入运行可指定绝对、仅服务账号可读写的临时根；默认系统临时目录/yingce-agent-runs。
# YINGCE_AGENT_TEMP_DIR=
# YINGCE_AGENT_RUN_DIR 仅供父进程内部传递，不要在部署配置或请求里设置。
CANVAS_UPDATER_SOCKET_DIR=/run/open-ai-canvas-updater

# 新服务器请直接运行 README 的一键部署命令；脚本会在 .env 中生成以下 PostgreSQL 配置。
# POSTGRES_DB=open_ai_canvas
# POSTGRES_USER=open_ai_canvas
# POSTGRES_PASSWORD=由部署脚本随机生成
# DATABASE_URL=postgresql://open_ai_canvas:随机密码@postgres:5432/open_ai_canvas?sslmode=disable
# REDIS_URL=redis://redis:6379/0
# CANVAS_POSTGRES_DATA_PATH=./postgres-data
# CANVAS_REDIS_DATA_PATH=./redis-data
# CANVAS_HTTP_PORT=3000

# 后端日志：info 级别不输出成功的查询请求与 Agent 流式事件；排障时临时改为 debug。
# CANVAS_LOG_LEVEL=info
# CANVAS_LOG_FORMAT=text
# CANVAS_LOG_SLOW_REQUEST=2s
# CANVAS_LOG_SLOW_SQL=500ms
