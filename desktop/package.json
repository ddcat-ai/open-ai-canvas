{
  "name": "dmc-desktop",
  "version": "1.8.5",
  "private": true,
  "description": "DMC · 本地优先的 AI 漫剧 / 短剧创作台",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.ll2.dmc",
    "productName": "DMC",
    "copyright": "Copyright © 2026 DMC",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-dist",
        "to": "web-dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DMC-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DMC",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
