{
  "port": 8787,
  "host": "127.0.0.1",
  "doubao": {
    "entryUrl": "https://www.doubao.com/chat/",
    "hostnames": [
      "www.doubao.com",
      "doubao.com"
    ],
    "selectors": {
      "composerHost": "[data-testid=\"chat_input_input\"]",
      "promptEditor": "[data-testid=\"chat_input_input\"] .ProseMirror, [data-testid=\"chat_input_input\"] [contenteditable=\"true\"]",
      "generateSubmit": "[data-testid=\"chat_input_send_button\"]",
      "uploadButton": "[data-testid=\"upload_file_button\"]",
      "fileInput": "input[type=\"file\"]",
      "loginButtonMarker": "[data-testid=\"to_login_button\"]",
      "chatStream": "[data-testid=\"message-list\"], [data-message-id]",
      "productVideo": "[class*=\"block-video\"] video, [class*=\"block-video\"] video source, video",
      "actionbarControl": "[data-input-engine-actionbar-control-key]"
    },
    "endpoints": {
      "completion": [
        "/samantha/chat/completion",
        "/alice/chat/completion",
        "/chat/completion"
      ],
      "chainSingle": "/im/chain/single",
      "playInfo": "/samantha/video/get_play_info"
    },
    "capture": {
      "chainSuppressMs": 10000,
      "domHoldMs": 5000,
      "baselineDelayMs": 3000,
      "taskTimeoutMs": 600000,
      "pollIntervalMs": 5000,
      "confirmTimeoutMs": 20000,
      "confirmPollMs": 1000,
      "videoMinCaptureMs": 15000
    },
    "idleEvictMs": 600000
  },
  "patch30": {
    "enabled": false,
    "targetDuration": 30,
    "targetModel": "seedance_v2.5",
    "cameraMovement": "fixed",
