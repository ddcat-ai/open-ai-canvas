{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "影策启动器",
  "version": "0.1.0",
  "identifier": "io.yingce.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "影策启动器",
        "width": 860,
        "height": 760,
        "minWidth": 620,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "影策本地启动与更新器",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi"
      }
    }
  }
}