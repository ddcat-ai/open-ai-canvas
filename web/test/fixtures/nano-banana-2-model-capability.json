{
    "version": 1,
    "image": {
        "parameters": [
            {
                "name": "size",
                "label": "图片尺寸",
                "type": "string",
                "description": "仅配置该模型支持的像素尺寸；auto 时不发送。",
                "values": ["auto", "1:1", "4:3", "3:4", "16:9", "9:16", "21:9"],
                "default": "1:1",
                "pricing": true,
                "binding": "aspectRatio",
                "encoding": "pixels"
            },
            {
                "name": "imageResolution",
                "label": "分辨率",
                "type": "string",
                "description": "按渠道配置的比例预设换算 size；上游只发送像素尺寸。",
                "values": ["auto", "1k", "2k", "4k"],
                "default": "1k",
                "pricing": true,
                "binding": "resolution"
            },
            {
                "name": "quality",
                "label": "图片质量",
                "type": "string",
                "description": "仅在模型支持时启用并填写可选值。",
                "pricing": true,
                "binding": "quality",
                "enabled": false
            },
            {
                "name": "count",
                "label": "生成数量",
                "type": "integer",
                "min": 1,
                "max": 1,
                "step": 1,
                "default": 1,
                "pricing": true,
                "binding": "imageCount"
            },
            {
                "name": "responseFormat",
                "label": "响应格式",
                "type": "string",
                "description": "仅在模型支持时启用，未指定则跟随上游。",
                "values": ["url", "b64_json"],
                "binding": "providerOptions.change2pro-image.response_format",
                "enabled": false
            },
            {
                "name": "seed",
                "label": "随机种子",
                "type": "integer",
                "binding": "providerOptions.gemini-image.seed",
                "enabled": false
            },
            {
                "name": "temperature",
                "label": "随机程度",
                "type": "number",
                "min": 0,
                "max": 2,
                "binding": "providerOptions.gemini-image.temperature",
                "enabled": false
            }
        ],
        "references": {
            "promptMaxChars": 32000,
            "maxImages": 16,
            "maxImageBytes": 31457280,
            "maskSupported": false
        },
        "size": {
            "parameter": "aspect_ratio",
            "values": ["auto", "1:1", "4:3", "3:4", "16:9", "9:16", "21:9"],
